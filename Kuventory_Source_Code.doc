          &lt;/TabsContent&gt;

          &lt;TabsContent value="summary" className="mt-0"&gt;
            &lt;SalesSummary /&gt;
          &lt;/TabsContent&gt;
        &lt;/div&gt;
      &lt;/Tabs&gt;
    &lt;/div&gt;
  );
}
